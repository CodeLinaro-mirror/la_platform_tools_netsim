test --verbose_failures --test_output=all

# Common flags for Release builds
build:opt --compilation_mode=opt
build:release-base --config=opt
build:release-base --copt="-O3"
build:release-base --copt="-DNDEBUG"
build:release-base --strip=always

# Linux release builds
build:linux --config=release-base
build:linux --linkopt="-Wl,-strip-all"

# Mac release builds
build:macos --config=release-base
build:macos --linkopt="-Wl,-S"
build:macos --macos_minimum_os=10.14
build:macos --host_macos_minimum_os=10.14
