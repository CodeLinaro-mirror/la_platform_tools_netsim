package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_link_api",
    crate_name: "link_api",
    stem: "liblink_api",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libnetsim_next_model",
        "libthiserror",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}
