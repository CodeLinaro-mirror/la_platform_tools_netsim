package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_bluetooth_actor",
    crate_name: "bluetooth_actor",
    stem: "libbluetooth_actor",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libbytes",
        "libfutures",
        "libhex",
        "libnetsim_next_actor_framework",
        "libnetsim_next_device_actor",
        "libnetsim_next_model",
        "libnetsim_next_packets",
        "libnetsim_next_rootcanal",
        "libnetsim_proto",
        "libserde",
        "libthiserror",
        "libtokio",
        "libtracing",
        "libzerocopy",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}
