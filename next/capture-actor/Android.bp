package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_capture_actor",
    crate_name: "capture_actor",
    stem: "libcapture_actor",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libbytes",
        "libfutures",
        "libnetsim_next_actor_framework",
        "libnetsim_next_capture_api",
        "libnetsim_next_common",
        "libnetsim_next_model",
        "libnetsim_next_packets",
        "libserde",
        "libthiserror",
        "libtokio",
        "libtokio_stream",
        "libtracing",
        "libzerocopy",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}
