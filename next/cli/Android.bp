package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_binary_host {
    name: "netsim_next_netsim",
    stem: "netsim_next_netsim",
    crate_root: "src/main.rs",
    srcs: [
        "src/main.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libclap",
        "libfutures",
        "libfutures_util",
        "libgrpcio",
        "libhex",
        "libnetsim_next_common",
        "libnetsim_next_packets",
        "libnetsim_proto",
        "libprotobuf",
        "libprotobuf_json_mapping",
        "libserde",
        "libserde_json",
        "libtracing",
    ],
}
