package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_nfc_actor",
    edition: "2024",
    crate_name: "nfc_actor",
    stem: "libnfc_actor",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libanyhow",
        "libbytes",
        "libcasimir",
        "libfutures",
        "libnetsim_next_actor_framework",
        "libnetsim_next_device_actor",
        "libnetsim_next_device_api",
        "libnetsim_next_model",
        "libthiserror",
        "libtokio",
        "libtokio_util",
        "libtracing",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}
