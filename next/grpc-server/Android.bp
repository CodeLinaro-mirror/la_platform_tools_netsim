package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_grpc_server",
    edition: "2024",
    crate_name: "grpc_server",
    stem: "libgrpc_server",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libbytes",
        "libfutures",
        "libgrpcio",
        "libnetsim_next_device_actor",
        "libnetsim_next_device_api",
        "libnetsim_next_link_actor",
        "libnetsim_next_link_api",
        "libnetsim_next_model",
        "libnetsim_next_packet_stream",
        "libnetsim_next_packets",
        "libnetsim_proto",
        "libprotobuf",
        "libtokio",
        "libtokio_stream",
        "libtracing",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}
