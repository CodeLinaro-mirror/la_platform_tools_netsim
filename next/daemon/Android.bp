package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_daemon_lib",
    crate_name: "daemon",
    stem: "libdaemon",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libclap",
        "libfutures",
        "libgrpcio",
        "libnetsim_next_bluetooth_actor",
        "libnetsim_next_capture_actor",
        "libnetsim_next_cell_actor",
        "libnetsim_next_common",
        "libnetsim_next_device_actor",
        "libnetsim_next_device_api",
        "libnetsim_next_grpc_server",
        "libnetsim_next_hci_server",
        "libnetsim_next_link_actor",
        "libnetsim_next_link_api",
        "libnetsim_next_model",
        "libnetsim_next_packet_stream",
        "libnetsim_next_uwb_actor",
        "libnetsim_next_websocket_server",
        "libtokio",
        "libtracing",
    ],
}

rust_binary_host {
    name: "netsim_next_daemon",
    stem: "netsim_next_daemon",
    crate_root: "src/main.rs",
    srcs: [
        "src/main.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libcommand_fds",
        "libnetsim_next_daemon_lib",
    ],
}
