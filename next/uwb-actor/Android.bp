package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_uwb_actor",
    edition: "2024",
    crate_name: "uwb_actor",
    stem: "libuwb_actor",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libbytes",
        "libfutures",
        "libglam",
        "libnetsim_next_actor_framework",
        "libnetsim_next_device_actor",
        "libnetsim_next_model",
        "libpdl_runtime",
        "libpica",
        "libserde",
        "libthiserror",
        "libtokio",
        "libtracing",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}
