package {
    default_applicable_licenses: ["tools_netsim_license"],
}

rust_library_host {
    name: "libnetsim_next_rootcanal",
    crate_name: "rootcanal",
    stem: "librootcanal",
    crate_root: "src/lib.rs",
    srcs: [
        "src/lib.rs",
    ],
    features: ["cuttlefish"],
    lints: "none",
    rustlibs: [
        "libbytes",
        "libparking_lot",
        "libthiserror",
        "libtracing",
    ],
    shared_libs: [
        "lib_rootcanal_ffi",
    ],
}
