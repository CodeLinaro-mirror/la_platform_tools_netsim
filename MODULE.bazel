"""netsim module"""

module(
    name = "netsim",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "grpc", version = "1.72.0")
bazel_dep(name = "rules_cc", version = "0.2.3")
bazel_dep(name = "rules_proto", version = "7.0.2")
bazel_dep(name = "rules_python", version = "1.4.0")
bazel_dep(name = "rules_rust", version = "0.64.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "30.2")

# pcre2 needed by glib.
bazel_dep(name = "pcre2", version = "10.46-DEV")
bazel_dep(name = "glib", version = "2.82.2.bcr.5")

# Non-module repos
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

[
    new_local_repository(
        name = path.split("/")[-1],
        build_file = "//build_files/{}:BUILD".format(path),
        path = "../../{}".format(path),
    )
    for path in [
        "tools/rootcanal",
        "external/libslirp",
        "external/fmtlib",
        "external/wpa_supplicant_8",
        "system/librustutils/rustutils",
    ]
]

new_local_repository(
    name = "aemu-base",
    build_file = "//build_files/hardware/google/aemu/base:BUILD",
    path = "../../hardware/google/aemu/base",
)

new_local_repository(
    name = "protobuf-rust",
    build_file = "//build_files/external/rust/android-crates-io/crates/protobuf:BUILD",
    path = "../../external/rust/android-crates-io/crates/protobuf",
)

[
    new_local_repository(
        name = crate,
        build_file = "//build_files/external/rust/android-crates-io/crates/{}:BUILD".format(crate),
        path = "../../external/rust/android-crates-io/crates/{}".format(crate),
    )
    for crate in [
        "aho-corasick",
        "android_log-sys",
        "anstyle",
        "anyhow",
        "argh",
        "argh_derive",
        "argh_shared",
        "arrayvec",
