    ]
]

[
    new_local_repository(
        name = crate,
        build_file = "//build_files/external/qemu/android/third_party/rust/crates/{}-{}:BUILD".format(crate, version),
        path = "../../external/qemu/android/third_party/rust/crates/{}-{}".format(crate, version),
    )
    for crate, version in [
        ("aead", "0.5.2"),
        ("aes", "0.8.4"),
        ("ccm", "0.5.0"),
        ("cipher", "0.4.4"),
        ("cpufeatures", "0.2.16"),
        ("crypto-common", "0.1.6"),
        ("ctr", "0.9.2"),
        ("generic-array", "0.14.7"),
        ("inout", "0.1.3"),
        ("subtle", "2.6.1"),
        ("typenum", "1.17.0"),
    ]
]

new_local_repository(
    name = "pica",
    build_file = "//build_files/external/rust/crates/pica:BUILD",
    path = "../../external/rust/crates/pica",
)

new_local_repository(
    name = "qemu",
    build_file = "//build_files/external/qemu:BUILD",
    path = "../../external/qemu",
    #    repo_mapping = {"@aemu-base": "@aemu-base"},
)

# Dependencies needed for external/wpa_supplicant_8
bazel_dep(name = "abseil-cpp", version = "20250127.1")
